# ================================
# Root Environment - Docker Compose Configuration
# ================================
# This file is used by docker-compose.local.yml to configure
# the PostgreSQL container and pass public variables to the frontend.
# Copy this file:
#   cp .env.example .env
# ================================

# Environment
NODE_ENV=local

# Database (used by the PostgreSQL Docker container)
POSTGRES_USER=willchain_local
POSTGRES_PASSWORD=your-local-db-password
POSTGRES_DB=willchain_local_db

# Blockchain (passed to the frontend container)
NEXT_PUBLIC_RPC_URL=https://sepolia.rpc.pinax.network/v1/your-api-key-here/
NEXT_PUBLIC_WILL_FACTORY_ADDRESS=0xYourWillFactoryContractAddress
