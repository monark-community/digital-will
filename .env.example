# ================================
# Environment Variables - Example
# ================================
# Copy this file to .env.local and adjust values as needed
# cp .env.example .env.local
# ================================

# ---- PostgreSQL ----
POSTGRES_USER=willchain_local
POSTGRES_PASSWORD=willchain_local_secret
POSTGRES_DB=willchain_local_db

# ---- Backend API ----
# Port for the Express server
API_PORT=4000

# ---- Frontend ----
# Port for the Next.js server
FRONTEND_PORT=3000

# API URL for client-side calls (from browser)
# In local dev with Docker, this should be http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
