# ================================
# Backend Environment - Example Template
# ================================
# Copy this file to create environment files:
# cp .env.example .env.local
# cp .env.example .env.development
# cp .env.example .env.production
# ================================

# Environment (local, development, production)
NODE_ENV=local

# Server
PORT=4000
HOSTNAME=0.0.0.0

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=willchain_local
POSTGRES_PASSWORD=willchain_local_secret
POSTGRES_DB=willchain_local_db
DATABASE_URL=postgres://willchain_local:willchain_local_secret@localhost:5432/willchain_local_db

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# API Configuration
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Optional: Authentication
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

# Optional: External Services
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Email (Resend)
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=notifications@yourdomain.com