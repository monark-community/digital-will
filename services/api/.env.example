# ================================
# Backend Environment - Example Template
# ================================
# Copy this file to create your local environment file:
#   cp .env.example .env
# ================================

# Environment (local, development, production)
NODE_ENV=local

# Server
PORT=4000
HOSTNAME=0.0.0.0

# Database
# When running with Docker Compose, use the Docker service name (postgres) as host.
# For a standalone local setup, use localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=willchain_local
POSTGRES_PASSWORD=your-local-db-password
POSTGRES_DB=willchain_local_db
DATABASE_URL=postgres://willchain_local:your-local-db-password@postgres:5432/willchain_local_db

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# API Configuration
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth / JWT
# Generate a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m

# WebSocket
WEBSOCKET_PORT=4001
WEBSOCKET_CORS_ORIGIN=http://localhost:3000

# Web app public URL (used in email links)
WEB_URL=http://localhost:3000

# Email (Resend)
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=notifications@yourdomain.com

# Blockchain RPC
# Get an endpoint from Alchemy, Infura, or Pinax
RPC_URL=https://sepolia.rpc.pinax.network/v1/your-api-key-here/
CHAIN_ID=11155111