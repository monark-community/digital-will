# ================================
# Substreams Environment - Example Template
# ================================
# Copy this file to create your local environment file:
#   cp .env.example .env
# ================================

# Path to the Substreams package file inside the Docker container.
# Do not change this unless you update the Dockerfile.
MANIFEST=/app/spkg/willchain-events-v0.1.0.spkg

# Substreams gRPC endpoint (network-specific)
SUBSTREAMS_URL=https://sepolia.substreams.pinax.network:443

# API key for the Substreams provider (Pinax or The Graph)
# Get your key at https://app.pinax.network or https://thegraph.com
SUBSTREAMS_API_KEY=your-substreams-api-key-here

# The Substreams module to run (defined in the .spkg)
SUBSTREAMS_MODULE=map_events_calls

# Ethereum chain ID (11155111 = Sepolia testnet)
CHAIN_ID=11155111

# Address of the deployed WillFactory smart contract
WILL_FACTORY_ADDRESS=0xYourWillFactoryContractAddress

# Ethereum block number at which the WillFactory contract was deployed.
# Substreams will start indexing from this block.
BLOCK_DEPLOYED=12345678
