# ================================
# Frontend Environment - Example Template
# ================================
# Copy this file to create your local environment file:
#   cp .env.example .env
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ================================

# Application environment (local, development, production)
NODE_ENV=local
NEXT_PUBLIC_APP_ENV=local

# Backend API URL (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Ethereum RPC endpoint (used for on-chain reads from the browser)
# Get an endpoint from Alchemy, Infura, or Pinax
NEXT_PUBLIC_RPC_URL=https://sepolia.rpc.pinax.network/v1/your-api-key-here/

# Address of the deployed WillFactory smart contract
NEXT_PUBLIC_WILL_FACTORY_ADDRESS=0xYourWillFactoryContractAddress
